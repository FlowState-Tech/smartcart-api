# Copy to .env or set these variables in your IDE / shell before running the API.

# Perfil Spring (elige uno):
#   local = H2 en memoria, NO necesitas PostgreSQL (recomendado para probar Swagger)
#   dev   = PostgreSQL en localhost:5432/smartcart_db
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (solo si usas perfil "dev")
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
AUTHORIZATION_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
AUTHORIZATION_JWT_EXPIRATION_DAYS=7

# Google Maps — enable "Directions API" in Google Cloud Console
GOOGLE_MAPS_API_KEY=

# Decolecta (RUC verification)
DECOLECTA_API_TOKEN=

# Optional
# SMARTCART_MAPS_PROVIDER=fallback
# SECURITY_LOG_LEVEL=INFO
